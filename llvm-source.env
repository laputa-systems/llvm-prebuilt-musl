# Single source of truth for the LLVM release built by this repository.
# Sourced by scripts, included by the Makefile, and appended to $GITHUB_ENV by CI.
# The digest is the sha256 published in the upstream release metadata for
# llvm-project-<version>.src.tar.xz (gh api repos/llvm/llvm-project/releases/tags/llvmorg-<version>).
LLVM_VERSION=23.1.2
LLVM_SOURCE_SHA256=c98bbef08a2b4c2613cd50e9aa9ae7b69b1fe6c16b2c40373bc0ab6116fdf78a
